{
  "name": "youtube-tutor",
  "version": "0.1.0",
  "private": true,
  "description": "A side-panel tutor for YouTube lectures: captions + the current frame + Claude.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs && node scripts/check-dist.mjs",
    "build:fast": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "preact": "^10.29.8",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
